{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "jest",
  "jest": {
    "configFile": "jest.config.js",
    "enableFindRelatedTests": false
  },
  "mutate": [
    "src/transfer_math.js",
    "src/bode_graph.js",
    "src/hover_nyquist.js",
    "src/quiz_scoring.js",
    "src/assignments.js",
    "src/presets_state.js",
    "src/quiz.js",
    "src/mouse_pressed.js",
    "src/mouse_drag.js",
    "src/graph_ui.js",
    "src/feedback.js"
  ],
  "ignorePatterns": [
    "docs",
    "e2e",
    "livet.se",
    "splash_screen",
    "php/_highscores.txt",
    "images/src",
    "audio/src",
    "coverage",
    "reports",
    "test-results",
    "playwright-report",
    ".stryker-tmp"
  ],
  "coverageAnalysis": "perTest",
  "timeoutMS": 10000,
  "timeoutFactor": 2,
  "incremental": true,
  "incrementalFile": "reports/stryker-incremental.json",
  "reporters": [
    "clear-text",
    "progress",
    "html"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/mutation.html"
  }
}
